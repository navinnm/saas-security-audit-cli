{
  "name": "saas-security-audit",
  "version": "0.4.0",
  "description": "SaaS security scanner CLI: finds tenant isolation gaps, IDOR/BOLA, missing Supabase RLS, leaked secrets, SQL injection, CORS and webhook flaws. Maps evidence to 22 controls. Local, read-only, no network.",
  "type": "module",
  "bin": {
    "saas-audit": "dist/cli.js",
    "saas-security-audit": "dist/cli.js"
  },
  "files": [
    "dist",
    "rules.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js",
    "test": "npm run build && node --test test/*.test.mjs",
    "sync-rules": "python3 scripts/sync-rules.py --plugin ../saas-security-audit/scripts/scan.py",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "security",
    "security-audit",
    "security-scanner",
    "saas",
    "saas-security",
    "multi-tenant",
    "tenant-isolation",
    "supabase",
    "row-level-security",
    "rls",
    "idor",
    "bola",
    "owasp",
    "sast",
    "secret-scanning",
    "appsec",
    "devsecops",
    "nextjs",
    "cli",
    "claude-code"
  ],
  "author": "Fulgid Software Solutions Pvt Ltd",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/navinnm/saas-security-audit-cli.git"
  },
  "homepage": "https://github.com/navinnm/saas-security-audit-cli#readme",
  "bugs": {
    "url": "https://github.com/navinnm/saas-security-audit-cli/issues"
  },
  "dependencies": {
    "ink": "5.2.1",
    "react": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/react": "18.3.31",
    "typescript": "5.9.3"
  }
}
